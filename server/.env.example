GEMINI_API_KEY=your_gemini_api_key
PORT=5001
CLIENT_ORIGIN=http://localhost:5173
# Optional Gmail + Calendar integration (OAuth 2.0 refresh token with gmail.send and calendar.events scopes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
APP_TIME_ZONE=Asia/Kolkata
# Optional; defaults to server/data/meetmind.sqlite
# DATABASE_PATH=/absolute/path/to/meetmind.sqlite
